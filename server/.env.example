# ===================================================
# TripTally Server Environment Variables Configuration
# ===================================================

# Server Port and Node Environment
PORT=5001
NODE_ENV=development

# Client Origin (CORS & Cookie credentials)
# In production, set to your live client URL, e.g., https://your-domain.com or https://your-bucket.cloudfront.net
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI
# Local dev: mongodb://localhost:27017/triptally
# Production: mongodb+srv://<username>:<password>@cluster0.mongodb.net/triptally?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/triptally

# JSON Web Token Secret & Expiration
JWT_SECRET=supersecret_triptally_dev_key_change_in_production
JWT_EXPIRES_IN=7d

# ---------------------------------------------------
# Razorpay Test-Mode Online Payments (Optional)
# If omitted or simulated keys are used, local simulation mode is activated
# ---------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# ---------------------------------------------------
# SMTP Email Service for Invitations & Reminders (Optional)
# If omitted, notifications log to console in local development
# ---------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="TripTally" <noreply@triptally.com>

# ---------------------------------------------------
# Cloudinary Credentials for Image Storage (Optional)
# If omitted, receipts and avatars are stored locally under /uploads
# ---------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------
# Google Gemini AI Itinerary Generator
# Get your free API key at: https://aistudio.google.com
# Keep this strictly server-side; NEVER expose to client.
# ---------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

